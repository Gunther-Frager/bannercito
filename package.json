{
  "name": "bannercito",
  "version": "1.0.1",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.patricio.bannercito",
    "productName": "Bannercito",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["portable"],
      "icon": "icon.ico"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "icon.png"
    },
    "files": [
      "**/*",
      "config.json"
    ]
  }
}